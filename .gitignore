/data/
raw_dumps/
*.parquet
*.duckdb
*.db
*.bson
*.tl
*.gz
*.csv

# C++ build
build/
build-*/
*.o
*.a
*.so
*.so.*
*.dylib
*.dylib.*
*.dll

# IDE
.vscode/
.idea/
*.swp

# secrets
.env
.env.local
*.pem
*.key

# OS
.DS_Store

# Python venv (量化离线栈)
.venv/

# Claude Code worktrees (本地并行开发, 不入 git)
.claude/worktrees/
.gitignore.backup
build_*/
build-*/
Testing/
.claire/
__pycache__/
*.pyc
frontend/dist/
.browser_test/
models/bench_fair.onnx
experiments/laolei-bm-slots/smoke
