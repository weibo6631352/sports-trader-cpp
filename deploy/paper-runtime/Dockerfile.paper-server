# deploy/paper-runtime/Dockerfile.paper-server
# owner: 老吴 (linux-sre-devops, A-unit, #10)
# last_review: 2026-05-29
#
# 目标: 多阶段构建 stcpp_paper_server + frontend SPA (SolidJS + Vite)
#   Stage 1 (node-builder)  — npm run build → frontend/dist/
#   Stage 2 (cpp-builder)   — gcc-13 + cmake + ninja → stcpp_paper_server binary
#   Stage 3 (runtime)       — Ubuntu 24.04 minimal: binary + dist/ 静态文件, 无 Node 运行时
#
# 对齐文档:
#   ADR-038 §5: 默认 127.0.0.1, 远程走 SSH 隧道, 不开 0.0.0.0
#   ADR-013 v2: eu-central-1 Frankfurt target
#   CLAUDE.md §10: 运行时纯 C++, Node 不进生产
#   CLAUDE.md R-11: PAPER_MODE=1 强制, 禁写 position/pnl_ledger/nonce_ledger
#   CLAUDE.md R-12: API server 独立线程, 不阻塞 hot path
#
# build (从仓库根执行):
#   docker build -f deploy/paper-runtime/Dockerfile.paper-server \
#                -t stcpp-paper-server:latest .
#
# run (本地验证, SSH 隧道 → 8080):
#   docker run --rm -p 127.0.0.1:8080:8080 \
#              -e PAPER_MODE=1 \
#              --env-file /etc/stcpp/paper.env \
#              stcpp-paper-server:latest
#
# Frankfurt 部署走 docker-compose.yml + systemd unit (stcpp-paper-server.service)

# ---------------------------------------------------------------------------
# Stage 1: node-builder — frontend npm run build
# ---------------------------------------------------------------------------
FROM node:20-slim AS node-builder

WORKDIR /frontend

# 先复制 package 文件利用 layer cache
COPY frontend/package.json frontend/package-lock.json ./

# npm ci 比 npm install 更适合 CI/CD: 严格按 package-lock.json, 失败报错
RUN npm ci --ignore-scripts

# 再复制源码 (layer cache 优化: 源码变动不重装 node_modules)
COPY frontend/ .

# 生产构建: tsc --noEmit + vite build → dist/
# vite.config.ts base: './' → 资源引用相对路径, 兼容 cpp-httplib 任意 mount 点
RUN npm run build

# ---------------------------------------------------------------------------
# Stage 2: cpp-builder — gcc-13 cmake ninja → stcpp_paper_server
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS cpp-builder

ARG DEBIAN_FRONTEND=noninteractive
ARG BUILD_TYPE=Release
# STCPP_EXEC_MODE: paper | live | backtest — 编译期常量注入 STCPP_EXEC_MODE_STR
ARG STCPP_EXEC_MODE=paper

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    gcc-13 \
    g++-13 \
    cmake \
    ninja-build \
    git \
    libssl-dev \
    zlib1g-dev \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/gcc gcc /usr/bin/gcc-13 100 \
 && update-alternatives --install /usr/bin/g++ g++ /usr/bin/g++-13 100

WORKDIR /src

# 复制 C++ 源码 (节点顺序: 先 CMakeLists, 再 include/src — 利用 layer cache)
COPY CMakeLists.txt .
COPY include/ include/
COPY src/ src/
COPY tests/ tests/

# cmake configure + build stcpp_paper_server target only
# --target stcpp_paper_server 跳过 paper_runtime / backtest binary, 加快构建
# STCPP_EXEC_MODE 决定 STCPP_EXEC_MODE_STR 编译期常量 (debug_server_main.cpp 引用)
# PAPER_MODE=ON: 链接 paper_engine, 跳过 live order submission + nonce_ledger 写
RUN cmake -B build \
      -G Ninja \
      -DCMAKE_BUILD_TYPE=${BUILD_TYPE} \
      -DPAPER_MODE=ON \
      -DSTCPP_EXEC_MODE=${STCPP_EXEC_MODE} \
      -DCMAKE_C_COMPILER=gcc-13 \
      -DCMAKE_CXX_COMPILER=g++-13 \
    && cmake --build build --target stcpp_paper_server --parallel

# ---------------------------------------------------------------------------
# Stage 3: runtime — minimal Ubuntu 24.04, 无 Node / 无编译工具
# ---------------------------------------------------------------------------
FROM ubuntu:24.04 AS runtime

ARG DEBIAN_FRONTEND=noninteractive

# 只装运行时依赖:
#   libssl3      — cpp-httplib TLS (ADR-018 header-only, runtime SSL 链接)
#   ca-certificates — HTTPS outbound (clob.polymarket.com / Goalserve)
#   curl         — HEALTHCHECK + 运维 probe
#   tzdata       — Europe/Berlin timezone (Frankfurt)
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libssl3 \
    ca-certificates \
    curl \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Frankfurt timezone
ENV TZ=Europe/Berlin
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone

# 非 root 运行 (ADR-038 §5 安全默认)
RUN useradd -r -s /bin/false -d /app stcpp

# 目录结构
RUN mkdir -p /app/bin /app/frontend/dist /app/data /app/logs /app/config \
 && chown -R stcpp:stcpp /app

# --- 从 cpp-builder 复制 binary ---
COPY --from=cpp-builder --chown=stcpp:stcpp \
    /src/build/src/stcpp/debug_api/stcpp_paper_server \
    /app/bin/stcpp_paper_server

# --- 从 node-builder 复制 frontend 静态文件 (无 Node 运行时) ---
# vite build outDir=dist, base='./' → 资源引用相对路径
# cpp-httplib mount_point("/", "/app/frontend/dist") 托管; API handler 优先
COPY --from=node-builder --chown=stcpp:stcpp \
    /frontend/dist/ \
    /app/frontend/dist/

# ---------------------------------------------------------------------------
# Healthcheck
# ---------------------------------------------------------------------------
# Liveness:  GET /healthz → {"ok":true,...} HTTP 200
#   判断: server 进程存活 + httplib event loop 响应
#   --start-period=30s: 给 binary 启动 + WSS 握手时间
#
# NOTE: Readiness (data_source != "stub-empty") 由 docker-compose healthcheck
#       或外部 probe 用 /status 判断 (见 docker-compose.yml)
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:8080/healthz | grep -q '"ok":true' || exit 1

WORKDIR /app

USER stcpp

# 运行时环境变量默认值 (可被 --env-file / docker run -e 覆盖)
ENV PAPER_MODE=1
ENV LOG_DIR=/app/logs
ENV DATA_DIR=/app/data

# ADR-038 §5: 默认 127.0.0.1 (不开 0.0.0.0), 远程走 SSH 隧道
# --frontend /app/frontend/dist: cpp-httplib 托管静态文件, 与 API 同源 :8080
# --real: 接真实 OrderBook snapshot (paper runtime 联动时启用; standalone 用 --demo 默认)
ENTRYPOINT ["/app/bin/stcpp_paper_server"]
CMD ["--host", "127.0.0.1", "--port", "8080", "--frontend", "/app/frontend/dist"]
