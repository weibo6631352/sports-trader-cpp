# clang-format (老高 v1 §1 命名 + §3 头文件 + §5 性能反模式 — 风格层面)
# 公司 C++20 ground-up. 本地 clang-format 22+ (brew llvm 22.1.6).
# CI pin clang-format-19 (ADR-032 §3 策略 2 pr.yml v2). 22 与 19 格式兼容 (Wave 74 验证).

BasedOnStyle: Google
Language: Cpp
Standard: c++20

# 缩进
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
AccessModifierOffset: -4
IndentCaseLabels: true
IndentPPDirectives: AfterHash

# 行宽
ColumnLimit: 110
PenaltyBreakBeforeFirstCallParameter: 1
PenaltyExcessCharacter: 1000000

# 大括号
BreakBeforeBraces: Attach
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: Never
AllowShortLoopsOnASingleLine: false
AllowShortLambdasOnASingleLine: Inline

# include 顺序 (老高 §3): own.h, std, third_party, project
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"[^/]+\.hpp"$'
    Priority: 1   # own.hpp
  - Regex: '^<[a-z_]+>$'
    Priority: 2   # std
  - Regex: '^<.*/.*>$'
    Priority: 3   # third_party
  - Regex: '^"stcpp/'
    Priority: 4   # project

# 指针 / 引用
DerivePointerAlignment: false
PointerAlignment: Left

# 模板
AlwaysBreakTemplateDeclarations: Yes

# 其他
FixNamespaceComments: true
NamespaceIndentation: None
ReflowComments: true
SpaceBeforeParens: ControlStatements
SpacesInAngles: false
Cpp11BracedListStyle: true
