	cd /Users/wangweibo/code/sports-trader-cpp/build_adr010 && $(MAKE) $(MAKESILENT) -f tests/unit/CMakeFiles/test_wal_writer.dir/build.make tests/unit/CMakeFiles/test_wal_writer.dir/test_wal_writer.cpp.i
.PHONY : test_wal_writer.cpp.i

test_wal_writer.s: test_wal_writer.cpp.s
.PHONY : test_wal_writer.s

# target to generate assembly for a file
test_wal_writer.cpp.s:
	cd /Users/wangweibo/code/sports-trader-cpp/build_adr010 && $(MAKE) $(MAKESILENT) -f tests/unit/CMakeFiles/test_wal_writer.dir/build.make tests/unit/CMakeFiles/test_wal_writer.dir/test_wal_writer.cpp.s
.PHONY : test_wal_writer.cpp.s

